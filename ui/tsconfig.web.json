{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"jsx": "react-jsx",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"noEmit": true,
		"baseUrl": ".",
		"paths": { "@shared/*": ["src/shared/*"] }
	},
	"include": ["src/renderer/src/**/*", "src/shared/**/*"]
}
