{
	"name": "edgehop-ui",
	"version": "0.2.0",
	"private": true,
	"description": "EdgeHop desktop UI: an Electron front end for the EdgeHop core process (docs/IPC.md)",
	"main": "./out/main/index.js",
	"engines": {
		"node": "^20.19.0 || >=22.12.0"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"preview:web": "vite --config vite.web.config.ts",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"pack": "electron-vite build && electron-builder --dir",
		"dist": "electron-vite build && electron-builder"
	},
	"devDependencies": {
		"@types/node": "^22.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@vitejs/plugin-react": "^6.1.2",
		"electron": "^44.8.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^6.0.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"typescript": "^5.9.0",
		"vite": "^8.3.4",
		"vitest": "^5.0.5"
	},
	"author": "EdgeHop",
	"homepage": "https://github.com/gherman7755/edgehop"
}
